import ifj26.*

def sq(x: Int): Int = x * x
def twice(x: Int) = x * 2
def greet(name: String) = "Hi " + name
def half(x: Double): Double = x / 2
def three(): Double = 3
def wrap(x: Int) = sq(x)

@main def main(): Unit =
  val a = sq(7)
  print(a)
  print("\n")
  val b = twice(a)
  print(b)
  print("\n")
  val c = greet("Bob")
  print(c)
  print("\n")
  val d = half(5)
  print(d)
  print("\n")
  val e = three()
  print(e)
  print("\n")
  val f = wrap(3)
  print(f)
  print("\n")
