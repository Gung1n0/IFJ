import ifj26.*

@main def main(): Unit =
  val a = isEven(10)
  print(a)
  print("\n")
  val b = isEven(7)
  print(b)
  print("\n")

def isEven(n: Int): Int =
  if n == 0 then
    return 1
  else
    val m = n - 1
    return isOdd(m)

def isOdd(n: Int): Int =
  if n == 0 then
    return 0
  else
    val m = n - 1
    return isEven(m)
