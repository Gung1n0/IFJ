import ifj26.*

def classify(x: Int): String =
  if x < 0 then
    return "negative"
  else
    if x == 0 then
      return "zero"
    else
      return "positive"

@main def main(): Unit =
  val m = -5
  val a = classify(m)
  print(a)
  print("\n")
  val b = classify(0)
  print(b)
  print("\n")
  val c = classify(7)
  print(c)
  print("\n")
